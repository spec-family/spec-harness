{
  "name": "@spec-family/spec-harness",
  "version": "0.24.2",
  "mcpName": "io.github.spec-family/spec-harness",
  "description": "The agent-facing member of the spec-* tools: context for a round, a guard on the agent's writes, an audit when it ends, probes that prove a defect before it is filed, and rulings a person signs.",
  "keywords": [
    "agents",
    "brief",
    "claude-code",
    "guardrails",
    "harness",
    "hooks",
    "mcp",
    "spec"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "spec-harness": "bin/spec-harness.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spec-brief-plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "/README.md",
    "docs/reference",
    "bin",
    "dist",
    "skills",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "src/vendor/spec-core/LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run stryker.core.config.mjs",
    "test:mutation:full": "stryker run",
    "prepublishOnly": "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') { console.error('npm publish is refused outside GitHub Actions: a release is a v* tag, staged by CI with provenance.'); process.exit(1) }\" && npm run clean && npm run build"
  },
  "peerDependencies": {
    "@spec-family/spec-brief": ">=0.12.0",
    "@spec-family/spec-graph": ">=0.21.0",
    "@spec-family/spec-guard": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@spec-family/spec-graph": {
      "optional": true
    },
    "@spec-family/spec-guard": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spec-family/spec-brief": "^0.13.1",
    "@spec-family/spec-guard": "^0.33.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spec-family/spec-harness.git"
  },
  "bugs": {
    "url": "https://github.com/spec-family/spec-harness/issues"
  },
  "homepage": "https://github.com/spec-family/spec-harness#readme",
  "overrides": {
    "qs": "^6.17.1"
  }
}
